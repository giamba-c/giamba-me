---
// src/layouts/Layout.astro
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="it">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Giambattista Carmignani - Tech Background & Operational Leader" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
		<title>{title}</title>
	</head>
	<body class="bg-[#f4f5f7] text-gray-900 font-sans antialiased overflow-hidden h-screen flex flex-col items-center justify-center selection:bg-orange-200 selection:text-orange-900">
        <slot />
	</body>
</html>

<style>
    body {
        font-family: 'Inter', sans-serif; /* Forziamo Inter */
    }
</style>