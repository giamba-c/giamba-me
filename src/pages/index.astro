---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Giambattista Carmignani">
	<main class="w-full max-w-[640px] px-6 relative z-10 flex flex-col items-center">
		
		<div class="w-full bg-white/80 backdrop-blur-2xl border border-white/40 shadow-[0_30px_60px_-15px_rgba(0,0,0,0.15)] rounded-2xl overflow-hidden transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] ring-1 ring-black/5"
             id="spotlight-container">
            
            <div class="flex items-center p-4">
                
                <div class="w-12 h-12 rounded-xl overflow-hidden shrink-0 mr-5 shadow-sm relative group cursor-default">
                     <img src="/logo_giambame.jpg" alt="g." class="w-full h-full object-cover opacity-90 group-hover:opacity-100 transition-opacity" />
                </div>
                
                <div class="flex-1 flex flex-col justify-center h-12">
                    <input 
                        type="text" 
                        class="w-full bg-transparent text-2xl font-light text-gray-900 placeholder-gray-400 outline-none border-none focus:ring-0 p-0 tracking-tight cursor-default"
                        readonly
                        value="Giambattista Carmignani"
                    />
                    <span class="text-[11px] text-gray-400 uppercase tracking-widest font-semibold pl-[1px] mt-0.5">Operational Leader & Tech Mindset</span>
                </div>
			</div>

            <div class="h-px w-full bg-gradient-to-r from-transparent via-gray-300/50 to-transparent"></div>

            <div id="content-area" class="transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] overflow-hidden">
                <div class="p-6 bg-white/40 text-gray-600 space-y-5 leading-relaxed font-light text-[16px]">
                    
                    <p>
                        Unisco <span class="font-medium text-gray-900">20 anni di leadership operativa</span> e disciplina sportiva (Ex-atleta Pro) con una formazione ingegneristica.
                    </p>
                    <p>
                        Applico il <strong class="font-semibold text-gray-900">pensiero algoritmico</strong> per risolvere problemi reali. Parlo la lingua della tecnologia per guidare strategie, non solo per scrivere sintassi.
                    </p>
                    
                    <div class="pt-2 flex flex-wrap gap-2">
                        <span class="px-3 py-1 bg-white/60 border border-gray-200 rounded-md text-xs font-medium text-gray-500">Efficienza</span>
                        <span class="px-3 py-1 bg-white/60 border border-gray-200 rounded-md text-xs font-medium text-gray-500">Struttura</span>
                        <span class="px-3 py-1 bg-white/60 border border-gray-200 rounded-md text-xs font-medium text-gray-500">Identità Digitale</span>
                    </div>
                </div>
            </div>

            <div class="bg-gray-50/50 backdrop-blur-sm p-3 flex justify-between items-center text-xs text-gray-500 font-medium border-t border-white/60">
				
                <div class="flex gap-2">
                    <button class="flex items-center gap-2 px-3 py-1.5 rounded-md hover:bg-white hover:shadow-sm transition-all text-gray-600 group" data-target="bio">
                        <svg class="w-4 h-4 text-gray-400 group-hover:text-orange-500 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                        <span>Bio</span>
                    </button>

                    <button class="flex items-center gap-2 px-3 py-1.5 rounded-md hover:bg-white hover:shadow-sm transition-all text-gray-600 group" data-target="works">
                        <svg class="w-4 h-4 text-gray-400 group-hover:text-blue-500 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
                        <span>Works</span>
                    </button>
                </div>

                <button class="flex items-center gap-2 px-3 py-1.5 rounded-md hover:bg-green-50 hover:text-green-700 transition-all text-gray-600" onclick="window.location.href='mailto:giambattista.carmignani@gmail.com'">
                    <svg class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                    <span>Contact</span>
                </button>
                
			</div>
		</div>
        
        <div class="mt-8 opacity-30 text-[10px] uppercase tracking-widest font-semibold hover:opacity-100 transition-opacity">
            Press Bio to Inspect
        </div>

	</main>
</Layout>

<script>
    const bioBtn = document.querySelector('button[data-target="bio"]');
    // Logica futura per interazione
</script>